# Server Port
PORT=5001

# MongoDB Connection String (Local or MongoDB Atlas Cloud)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pmcfms

# JWT Authentication Secret Key
JWT_SECRET=supersecret_pmcfms_key_2026

# Environment
NODE_ENV=production

# Email Config (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=PMCFMS Support

# Somali SMS Provider Config
SOMALI_SMS_URL=http://api.yourprovider.com/send
SOMALI_SMS_USER=your_username
SOMALI_SMS_PASS=your_password

# Image Cloud Storage Config (ImageKit / Supabase)
# ImageKit Config (Recommended)
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Supabase Config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
